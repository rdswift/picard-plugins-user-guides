#: ../../genre_mapper/user_guide.rst:2
msgid "Genre Mapper"
msgstr ""

#: ../../genre_mapper/user_guide.rst:5
msgid "Overview"
msgstr ""

#: ../../genre_mapper/user_guide.rst:7
msgid "This plugin provides the ability to standardize genres in the \"genre\" tag by matching the genres as found to a standard genre as defined in the genre replacement mapping configuration option. Once installed a settings page will be added to Picard's options, which is where the plugin is configured."
msgstr ""

#: ../../genre_mapper/user_guide.rst:11
msgid "What it Does"
msgstr ""

#: ../../genre_mapper/user_guide.rst:13
msgid "This plugin reads the track metadata provided to Picard, extracts the list of associated genres, and maps the existing genres to new values based on the configured replacement pairs."
msgstr ""

#: ../../genre_mapper/user_guide.rst:17
msgid "The plugin does not add any new genres to the \"genre\" tag. It only modifies existing genres based on the configured replacement pairs."
msgstr ""

#: ../../genre_mapper/user_guide.rst:19
msgid "All genres will be output in title case (e.g., \"Rock\" instead of \"rock\") regardless of the case used in the replacement pairs."
msgstr ""

#: ../../genre_mapper/user_guide.rst:23
msgid "Option Settings"
msgstr ""

#: ../../genre_mapper/user_guide.rst:25
msgid "The plugin adds a settings page under the \"Plugins\" section under \"Options...\" from Picard's main menu. This allows you to control how the plugin operates with respect to remapping the genres."
msgstr ""

#: ../../genre_mapper/user_guide.rst:27
msgid "Genre Mapper Option Settings"
msgstr ""

#: ../../genre_mapper/user_guide.rst:34
msgid "Enable genre mapping"
msgstr ""

#: ../../genre_mapper/user_guide.rst:36
msgid "This setting allows you to enable or disable the genre mapping functionality. If disabled, the plugin will not modify any genres."
msgstr ""

#: ../../genre_mapper/user_guide.rst:40
msgid "Match tests are entered as regular expressions"
msgstr ""

#: ../../genre_mapper/user_guide.rst:42
msgid "This setting allows you to specify whether the match test strings in the replacement pairs are treated as regular expressions or as simple wildcard patterns."
msgstr ""

#: ../../genre_mapper/user_guide.rst:44
msgid "If enabled, the match test string portion of **every** pair must be a valid regular expression. Invalid regular expressions will be ignored and logged as errors. Otherwise, the match test strings can use the '*' and '?' wildcards to match any number of characters and a single character respectively."
msgstr ""

#: ../../genre_mapper/user_guide.rst:46
msgid "If enabled, the replacement portion of the pair can include backreferences to capture groups specified in the match test string. Otherwise, the replacement portion of the pair is treated as a literal string and will not be interpreted as a wildcard pattern."
msgstr ""

#: ../../genre_mapper/user_guide.rst:50
msgid "For more information about regular expressions, please refer to the `Python Regular Expressions <https://docs.python.org/3/library/re.html>`_ documentation, `Wikipedia <https://en.wikipedia.org/wiki/Regular_expression>`_, and the `Regular Expressions Tutorial <https://www.geeksforgeeks.org/dsa/write-regular-expressions/>`_."
msgstr ""

#: ../../genre_mapper/user_guide.rst:54
msgid "Apply only the first matching replacement"
msgstr ""

#: ../../genre_mapper/user_guide.rst:56
msgid "This setting allows you to choose whether or not to apply the first matching pair only, or continue processing the remaining pairs with the updated genre. By default, all of the pairs are processed."
msgstr ""

#: ../../genre_mapper/user_guide.rst:60
msgid "Case-sensitive matching"
msgstr ""

#: ../../genre_mapper/user_guide.rst:62
msgid "This setting determines whether or not the match tests are performed as case-sensitive. This applies to both regular expressions and wildcard patterns. By default, the match tests are case-insensitive."
msgstr ""

#: ../../genre_mapper/user_guide.rst:66
msgid "Verbose debug logging"
msgstr ""

#: ../../genre_mapper/user_guide.rst:68
msgid "This setting allows you to enable or disable verbose debug logging. If enabled, the plugin will log additional information about the processing of the genre mapping, which can be useful for troubleshooting. Errors are always logged regardless of this setting."
msgstr ""

#: ../../genre_mapper/user_guide.rst:72
msgid "Replacement Pairs"
msgstr ""

#: ../../genre_mapper/user_guide.rst:74
msgid "This setting allows you to specify the list of original/replacement pairs used to modify the genres provided in the \"genre\" tag. Each pair must be entered on a separate line in the form:"
msgstr ""

#: ../../genre_mapper/user_guide.rst:80
msgid "If the \"Match tests are entered as regular expressions\" option is disabled, supported wildcards in the test string part of the mapping include '*' and '?' to match any number of characters and a single character respectively. The replacement portion of the pair is treated as a literal string and will not be interpreted as a wildcard pattern."
msgstr ""

#: ../../genre_mapper/user_guide.rst:82
msgid "If the \"Match tests are entered as regular expressions\" option is enabled, then the match test string portion of **every** pair must be entered as a regular expression. The replacement portion of the pair can include backreferences to capture groups specified in the match test string."
msgstr ""

#: ../../genre_mapper/user_guide.rst:84
msgid "Blank lines and lines beginning with an equals sign (=) will be ignored. This allows you to add comments and blank lines to the replacement pairs configuration for readability."
msgstr ""

#: ../../genre_mapper/user_guide.rst:86
msgid "Leading and trailing spaces will be removed from all match test strings and replacement strings before processing."
msgstr ""

#: ../../genre_mapper/user_guide.rst:88
msgid "If the replacement part of the pair is blank, any matching genres will be removed."
msgstr ""

#: ../../genre_mapper/user_guide.rst:90
msgid "Replacements will be made in the order they are found in the list."
msgstr ""

