#: ../../called_folk_dance_tags/user_guide.rst:2
msgid "Called Folk Dance Tags"
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:5
msgid "Overview"
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:7
msgid "This plugin adds tags for traditional called folk dances based on the IETF Internet-Draft (I-D) `draft-swhited-contra-tags-04 <https://datatracker.ietf.org/doc/draft-swhited-contra-tags/>`_ by Sam Whited. The plugin registers the tags, with descriptions, for easy lookup in the script editor. It does not populate any of the tags."
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:11
msgid "This plugin makes no additional calls to the MusicBrainz website api for the information."
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:15
msgid "What it Does"
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:17
msgid "This plugin registers the new tags within Picard so that they are available for lookup and autocompletion in the script editor. In addition, it provides proper names for the tags in the metadata editor panel. It does not populate any of the tags."
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:21
msgid "Option Settings"
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:23
msgid "The plugin has no option settings."
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:27
msgid "Tags Registered"
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:29
msgid "**dance_caller** - The name of the dance callers heard in the track."
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:30
msgid "**dance_choreographer** - The names of the authors of the dances being called."
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:31
msgid "**dance_choreography** - The moves of the dance as text for called folk dances."
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:32
msgid "**dance_crooked** - Whether a traditional called folk dance tune is \"crooked\" (ie. not in perfect dance form)."
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:33
msgid "**dance_form** - The form of a called dance with no particular format, eg. \"contra\" or \"square dance\" or \"duple minor improper contra\"."
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:34
msgid "**dance_intro** - The number of intro beats before the dance or any potatoes for called folk dances."
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:35
msgid "**dance_issong** - Whether the track is a song (has sung vocals other than the caller) or a tune (instrumental only) for traditional music forms that make this distinction."
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:36
msgid "**dance_license** - Like the license field except relating to the choreography of the dance being called for called folk dances."
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:37
msgid "**dance_potatoes** - The number of \"potatoes\" (syncronization beats played before some traditional folk dances)."
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:38
msgid "**dance_roles** - The role terms used for calls in a called folk dance, eg. \"Larks/Robins\" or \"Leads/Follows\" or \"Positional\"."
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:39
msgid "**dance_start** - The start time (in milliseconds) of the first time through the dance in a called folk dance."
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:40
msgid "**dance_times** - The number of complete times through the dance excluding any intro, outro, or potatoes for a called folk dance. The exact definition will depend on the type of dance."
msgstr ""

#: ../../called_folk_dance_tags/user_guide.rst:41
msgid "**dance_title** - The name of the dances being called for called folk dances."
msgstr ""

